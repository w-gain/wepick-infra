# Domain / TLS (Caddy가 자동 발급)
DOMAIN_NAME=wepick.example.com
ACME_EMAIL=admin@example.com

# 애플리케이션 이미지 (로컬 빌드 이미지 또는 레지스트리 이미지)
FE_IMAGE=wepick-fe
FE_IMAGE_TAG=local
BE_IMAGE=wepick-be
BE_IMAGE_TAG=local

# MySQL — 실제 값은 커밋하지 않습니다.
MYSQL_DATABASE=wepick
MYSQL_USER=wepick
MYSQL_PASSWORD=replace-with-a-long-random-password
MYSQL_ROOT_PASSWORD=replace-with-a-different-long-random-password
